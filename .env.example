# BACOS environment — copy to .env and fill values. NEVER commit real keys.

# ── Backend database ──
PGHOST=localhost
PGPORT=5432
PGDATABASE=bacos
PGUSER=postgres
PGPASSWORD=change-me

# ── AI provider (server-side only — keys never ship inside the APK) ──
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
AI_MODEL=gpt-4o-mini

# ── Server ──
PORT=8080
